---
import Icon from './Icon.astro';

interface Props {
  file?: string;
  lang?: string;
  note?: string;
  class?: string;
}

const { file, lang, note, class: className = '' } = Astro.props;
const hasHeader = Boolean(file || lang || note);
---

<div class:list={['copy-scope relative overflow-hidden rounded-xl border border-codeline bg-codebg', className]}>
  {
    hasHeader ? (
      <div class="flex items-center justify-between gap-3 border-b border-codeline px-4 py-2.5">
        <span class="min-w-0 truncate font-mono text-xs text-codeink/75">{file ?? lang ?? ''}</span>
        <div class="flex shrink-0 items-center gap-2">
          {note && <span class="hidden max-w-[36ch] truncate text-xs text-codeink/60 md:inline">{note}</span>}
          {lang && file && (
            <span class="rounded-full border border-codeline px-2 py-0.5 font-mono text-[11px] leading-4 text-codeink/70">{lang}</span>
          )}
          <button type="button" data-copy-btn class="copy-btn" aria-label="复制代码">
            <Icon name="copy" class="copy-icon size-3.5" />
            <Icon name="check" class="check-icon size-3.5" />
            <span class="copy-label">复制</span>
            <span class="copied-label">已复制</span>
          </button>
        </div>
      </div>
    ) : (
      <button
        type="button"
        data-copy-btn
        class="copy-btn absolute right-2 top-2 opacity-60 transition-opacity hover:opacity-100 focus-visible:opacity-100"
        aria-label="复制代码"
      >
        <Icon name="copy" class="copy-icon size-3.5" />
        <Icon name="check" class="check-icon size-3.5" />
        <span class="copy-label">复制</span>
        <span class="copied-label">已复制</span>
      </button>
    )
  }
  <pre class="overflow-x-auto p-4 font-mono text-xs leading-relaxed text-codeink"><code><slot /></code></pre>
</div>
