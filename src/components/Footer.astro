---
import Icon from './Icon.astro';

const columns: {
  title: string;
  twoCol?: boolean;
  links: { href: string; label: string; internal?: boolean }[];
}[] = [
  {
    title: '文档',
    twoCol: true,
    links: [
      { href: '/intro', label: '简介', internal: true },
      { href: '/install', label: '安装指南', internal: true },
      { href: '/modules', label: '核心模块', internal: true },
      { href: '/datatypes', label: '数据类型', internal: true },
      { href: '/tutorials', label: '教程导航', internal: true },
      { href: '/dnn', label: '深度学习', internal: true },
      { href: '/examples', label: '示例代码', internal: true },
      { href: '/faq', label: '常见问题', internal: true },
    ],
  },
  {
    title: '官方链接',
    links: [
      { href: 'https://docs.opencv.org/5.0/', label: 'OpenCV 5.0 文档' },
      { href: 'https://docs.opencv.org/5.0/tutorials/tutorials.html', label: '官方教程' },
      { href: 'https://docs.opencv.org/5.0/py_tutorials/py_tutorials.html', label: 'Python 教程' },
      { href: 'https://docs.opencv.org/5.0/js_tutorials/js_tutorials.html', label: 'OpenCV.js 教程' },
      { href: 'https://opencv.org/courses', label: '官方课程' },
    ],
  },
  {
    title: '社区与项目',
    twoCol: true,
    links: [
      { href: 'https://opencv.org', label: 'opencv.org' },
      { href: 'https://forum.opencv.org', label: '问答论坛' },
      { href: 'https://github.com/opencv/opencv', label: 'GitHub 仓库' },
      { href: 'https://github.com/opencv/opencv/issues', label: '问题追踪' },
      { href: 'https://github.com/opencv/opencv_contrib', label: 'opencv_contrib' },
      { href: 'https://youtube.com/@opencvofficial', label: 'YouTube 频道' },
      { href: 'https://opencv.ai', label: 'OpenCV.ai' },
    ],
  },
];
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2.5 font-bold text-ink">
          <span class="grid size-7 place-items-center rounded-md bg-accent text-xs font-black text-accent-ink">CV</span>
          OpenCV
        </div>
        <p class="mt-4 max-w-[46ch] text-sm leading-relaxed text-muted">
          开源计算机视觉与机器学习库的非官方中文站点，内容基于 OpenCV 5.0 官方文档与社区 README 整理。
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          <li class="chip">Apache 2.0</li>
          <li class="chip">C++17+</li>
          <li class="chip">Python 3.6+</li>
        </ul>
      </div>
      <div class="grid gap-8 sm:grid-cols-3 lg:col-span-8">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-sm font-semibold text-ink">{col.title}</h3>
              <ul class:list={['mt-4 grid gap-y-2.5', col.twoCol && 'sm:grid-cols-2 sm:gap-x-4']}>
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.internal ? undefined : '_blank'}
                      rel={link.internal ? undefined : 'noopener'}
                      class="text-sm text-muted transition-colors hover:text-accent"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
      <p class="text-xs text-faint">
        OpenCV 以 Apache 2.0 许可证发布。本站为社区中文整理，与 OpenCV 官方无关。
      </p>
      <div class="flex items-center gap-1">
        <a
          href="https://github.com/opencv/opencv"
          target="_blank"
          rel="noopener"
          aria-label="GitHub 仓库"
          class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:text-ink"
        >
          <Icon name="github-logo" class="size-5" />
        </a>
        <a
          href="https://x.com/opencvofficial"
          target="_blank"
          rel="noopener"
          aria-label="X 账号"
          class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:text-ink"
        >
          <Icon name="x" class="size-5" />
        </a>
      </div>
    </div>
  </div>
</footer>
