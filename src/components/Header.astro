---
import Icon from './Icon.astro';

const nav = [
  { href: '/', label: '首页' },
  { href: '/intro', label: '简介' },
  { href: '/install', label: '安装' },
  { href: '/modules', label: '模块' },
  { href: '/datatypes', label: '数据类型' },
  { href: '/tutorials', label: '教程' },
  { href: '/dnn', label: '深度学习' },
  { href: '/examples', label: '示例' },
  { href: '/resources', label: '资源' },
  { href: '/contribute', label: '贡献' },
  { href: '/faq', label: 'FAQ' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-bold text-ink">
      <span class="grid size-8 place-items-center rounded-lg bg-accent text-sm font-black text-accent-ink">CV</span>
      <span class="hidden sm:inline">OpenCV 中文文档</span>
    </a>
    <nav class="hidden items-center lg:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative rounded-md px-2 py-2 text-sm transition-colors',
              path === item.href
                ? 'font-semibold text-accent'
                : 'text-muted hover:text-ink',
            ]}
            aria-current={path === item.href ? 'page' : undefined}
          >
            {item.label}
            {path === item.href && <span class="absolute inset-x-2 -bottom-px h-0.5 rounded-full bg-accent" />}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/opencv/opencv"
        target="_blank"
        rel="noopener"
        aria-label="GitHub 仓库"
        class="hidden size-9 place-items-center rounded-full text-muted transition-colors hover:text-ink md:grid"
      >
        <Icon name="github-logo" class="size-5" />
      </a>
      <button
        id="menu-toggle"
        class="grid size-9 place-items-center rounded-full border border-line text-ink lg:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="list" class="menu-open-icon size-5" />
        <Icon name="x" class="menu-close-icon hidden size-5" />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-line bg-canvas px-4 py-3 lg:hidden" aria-label="移动导航">
    <ul class="grid gap-1 sm:grid-cols-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm',
                path === item.href ? 'bg-accent-soft font-semibold text-accent' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    toggle?.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
    toggle?.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
