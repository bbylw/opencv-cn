---
// Icon component inlining SVG assets from @phosphor-icons/core (MIT license).
// Assets are vendored into src/icons/ at build-setup time; do not hand-draw new paths.
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
let svg = icons[`../icons/${name}.svg`] ?? '';

// Let the host control sizing via currentColor / CSS classes.
svg = svg.replace('<svg ', '<svg fill="currentColor" aria-hidden="true" ');
---

<Fragment set:html={svg.replace('<svg ', `<svg class="${className}" `)} />
