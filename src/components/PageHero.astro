---
interface Props {
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}

const { title, lead, crumbs } = Astro.props;
---

<header class="border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    {
      crumbs && crumbs.length > 0 && (
        <nav class="mb-4 flex items-center gap-2 text-xs text-faint" aria-label="面包屑">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              <a href={c.href} class="transition-colors hover:text-accent">
                {c.label}
              </a>
            </>
          ))}
        </nav>
      )
    }
    <h1 class="text-3xl font-black tracking-tight text-ink md:text-4xl">{title}</h1>
    {lead && <p class="mt-4 max-w-[65ch] leading-relaxed text-muted" set:html={lead} />}
  </div>
</header>
